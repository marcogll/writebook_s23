# Writebook S23 - Environment Configuration
# Copy this file to .env and adjust values as needed

# SSL Configuration
# Option 1: Disable SSL (for local/dev or behind reverse proxy)
DISABLE_SSL=true

# Option 2: Enable automatic SSL via Let's Encrypt (comment out DISABLE_SSL first)
# SSL_DOMAIN=docs.miempresa.com

# Server Settings
RAILS_MAX_THREADS=5
PORT=3000
